@model IEnumerable<ButceTakipSistemi.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>📂 Kategoriler</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Yeni Kategori Ekle
    </a>
</div>

<table class="table table-hover table-bordered shadow-sm bg-white">
    <thead class="table-light">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th class="text-center" style="width: 200px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle">
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td class="align-middle">
                    @if (item.Type == 1)
                    {
                        <span class="badge bg-success">Gelir</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Gider</span>
                    }
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-success">
                        ✏️ Düzenle
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                        🗑️ Sil
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>