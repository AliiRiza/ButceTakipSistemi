@model ButceTakipSistemi.Models.Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<h2 class="mb-4">📂 Yeni Kategori Ekle</h2>

<hr />
<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="control-label fw-bold">Kategori Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: Mutfak, Maaş..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Type" class="control-label fw-bold">Tip (0: Gider, 1: Gelir)</label>
                        <input asp-for="Type" class="form-control" placeholder="0 veya 1 giriniz" />
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary">
                            💾 Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            ↩️ Listeye Dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}