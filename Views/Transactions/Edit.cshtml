@model ButceTakipSistemi.Models.Transaction

@{
    ViewData["Title"] = "İşlemi Düzenle";
}

<h2 class="mb-4">✏️ İşlemi Düzenle</h2>

<hr />
<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label fw-bold">Açıklama</label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="control-label fw-bold">Tutar (TL)</label>
                        <input asp-for="Amount" class="form-control" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Date" class="control-label fw-bold">Tarih</label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="control-label fw-bold">Kategori</label>
                        <select asp-for="CategoryId" class="form-control form-select" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-4">
                        <input type="submit" value="💾 Değişiklikleri Kaydet" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary ms-2">↩️ Listeye Dön</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}